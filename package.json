{
  "name": "terramentor",
  "version": "1.0.0",
  "description": "A local-first mastery engine for self-directed learners: it plans a curriculum against your deadline, writes the material and teaches it, asks you to prove each topic before it closes, and brings back what you are forgetting.",
  "license": "AGPL-3.0-or-later",
  "author": "ValeraZSD <valerazsd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValeraZSD/terramentor.git"
  },
  "bugs": {
    "url": "https://github.com/ValeraZSD/terramentor/issues"
  },
  "homepage": "https://github.com/ValeraZSD/terramentor#readme",
  "keywords": [
    "spaced-repetition",
    "flashcards",
    "srs",
    "fsrs",
    "anki",
    "learning",
    "study-planner",
    "curriculum",
    "mastery-learning",
    "bayesian-knowledge-tracing",
    "local-first",
    "self-hosted",
    "ollama",
    "offline"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "standalone": "vite build && node --env-file-if-exists=.env server/index.js",
    "standalone:watch": "concurrently \"vite build --watch\" \"node --env-file-if-exists=.env server/index.js\"",
    "desktop": "node --env-file-if-exists=.env desktop/launcher.js",
    "build:desktop": "node tools/build-desktop.mjs",
    "start": "npm run dev",
    "hooks": "git config core.hooksPath .githooks",
    "test": "node tools/run-gates.mjs",
    "test:quick": "node tools/run-gates.mjs --quick",
    "i18n:audit": "node tools/i18n-audit.mjs",
    "i18n:extract": "node tools/i18n-extract.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@napi-rs/canvas": "0.1.80",
    "@tesseract.js-data/eng": "^1.0.0",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "function-plot": "^1.25.4",
    "gifenc": "^1.0.3",
    "hast-util-sanitize": "5.0.2",
    "i18next": "^26.4.2",
    "json5": "^2.2.3",
    "jszip": "^3.10.1",
    "katex": "0.16.45",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "multer": "^2.2.0",
    "ollama": "^0.6.3",
    "p5": "^1.11.13",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "smiles-drawer": "^2.4.1",
    "sqlite-vec": "^0.1.9",
    "tesseract.js": "^5.1.1",
    "ts-fsrs": "^5.4.1",
    "vega-embed": "^7.1.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "esbuild": "0.21.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "overrides": {
    "uuid": "^11.1.0",
    "qs": "^6.16.0"
  }
}
