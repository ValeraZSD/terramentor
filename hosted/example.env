# Copy to hosted/.env and fill in. copy.sh reads it; nothing in it is committed.

# Every copy is <name>.<TM_DOMAIN>. Point a wildcard DNS record
# (*.study.example.org) at this server before creating the first copy.
TM_DOMAIN=study.example.org
# The certificate authority writes here when a certificate is about to expire.
ACME_EMAIL=you@example.org

# The image every copy runs. Pin a version: `latest` moves under you.
TM_IMAGE=ghcr.io/valerazsd/terramentor:1

# Per copy: a ceiling, not a reservation. One copy measured at 246 MiB at its
# peak (docs/HOSTING.md, "How big a server"); raise it for someone who imports
# large Anki decks.
TM_MEMORY=768m
TM_CPUS=1
TM_PIDS=256

# Where `copy.sh backup` writes, one folder per copy. A mounted Storage Box
# works; so does a local disk that something else copies off the server.
TM_BACKUP_DIR=/srv/terramentor-backups
# How many nightly archives to keep per copy.
TM_BACKUP_KEEP=14

# The model every copy uses (any OpenAI-compatible endpoint). The key is per
# copy: `copy.sh new <name> --ai-key-file <file>` (docs/HOSTING.md).
AI_PROVIDER=openai
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=

# Rehearsal on one computer only: certificates from Caddy's own local
# authority instead of a public one, and ports that are free.
# TM_TLS=internal
# TM_HTTP_PORT=8080
# TM_HTTPS_PORT=8443
