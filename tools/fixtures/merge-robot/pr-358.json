     {
      "sha": "43c71d07cf13e5cb4d29b7e4063bc8b0057dbf38"
     }
    ],
    "commit": {
     "message": "Name both 't kofschip exceptions up front\n\nSigned-off-by: ValeraZSD <valerazsd@gmail.com>",
     "committer": {
      "date": "2026-11-24T14:06:16Z"
     }
    }
   },
