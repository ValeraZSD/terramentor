  "/repos/ValeraZSD/terramentor/pulls/331/commits?per_page=100&page=1": [
   {
    "sha": "b88500a40bf1391d9495c4ff4d2e6c25b21e9027",
    "parents": [
     {
      "sha": "c82ef280039bc8faff9d003984f1ca590e98e04c"
     }
    ],
    "commit": {
     "message": "Hosted guard: trimmed flag, absolute-form paths\n\nisHosted now trims TERRAMENTOR_HOSTED like the start-up check does, and the site library asks isHosted instead of its own exact test, so a value such as '1 ' no longer starts a copy with every hosted rule off. requestPath reads an absolute-form request line (PUT http://host/api/ai/key) by its pathname and drops a fragment, which is how the router routes both.\n\nSigned-off-by: ValeraZSD <owner@example.test>",
     "committer": {
      "date": "2026-11-21T14:07:23Z"
     }
    }
   },
   {
    "sha": "3a19ca52e7850c92060fd4e4a1dc30958ec2df84",
    "parents": [
     {
      "sha": "b88500a40bf1391d9495c4ff4d2e6c25b21e9027"
     }
    ],
    "commit": {
     "message": "First-password setup for devices; quieter log\n\nA device this computer already let in (a connected device, the owner's Tailscale) sets the first password without the code from the server log, as this machine does; any other remote request still needs it. The setup code is printed when it is made and then at most once a minute, instead of on every status poll.\n\nSigned-off-by: ValeraZSD <owner@example.test>",
     "committer": {
      "date": "2026-11-21T14:07:23Z"
     }
    }
   },
   {
    "sha": "9566f0d0b29256700d21d774aa7210424db92f9a",
    "parents": [
     {
      "sha": "3a19ca52e7850c92060fd4e4a1dc30958ec2df84"
     }
    ],
    "commit": {
     "message": "Describe what the health check does\n\nSigned-off-by: ValeraZSD <owner@example.test>",
     "committer": {
      "date": "2026-11-21T14:07:24Z"
     }
    }
   },
   {
    "sha": "9714dffcdd88a32235c9b1df9a1b3c69765c1187",
    "parents": [
     {
      "sha": "9566f0d0b29256700d21d774aa7210424db92f9a"
     }
    ],
    "commit": {
     "message": "Guard hosted paths as the router parses them\n\nThe guard now reads the path the router itself parsed (baseUrl + path) instead of the raw request line, so spellings such as http:///api/ai/key, a port out of range or an empty host after @ are refused too.\n\nSigned-off-by: ValeraZSD <owner@example.test>",
     "committer": {
      "date": "2026-11-21T14:13:58Z"
     }
    }
   },
   {
    "sha": "1fb4f9d3ff6a8e21af4c0413850ab68806ac705c",
    "parents": [
     {
      "sha": "9714dffcdd88a32235c9b1df9a1b3c69765c1187"
     }
    ],
    "commit": {
     "message": "Print the setup code again after a clock step\n\nSigned-off-by: ValeraZSD <owner@example.test>",
     "committer": {
      "date": "2026-11-21T14:13:59Z"
     }
    }
   }
  ],
