   {
    "sha": "7c69f27dd8aac57d63d8c24cb98e068a496bfdbb",
    "parents": [
     {
      "sha": "4c30f6486cc73a4b8f021b5b37a521c0e9fbec4a"
     }
    ],
    "commit": {
     "message": "Stop on an empty 404, warn for embeddings\n\nA hosted OpenRouter 404 with no body is taken as the zero-retention\nrefusal: a failed body read arrives empty, and an ordinary failure would\nlet the job chain move the text to a backup endpoint. The start-up\nwarning now also follows document chunks sent for embeddings when chat\nruns on a local model, and the feed writer hands its task the error so\nthe task record keeps the refusal flag.\n\nSigned-off-by: ValeraZSD <valerazsd@gmail.com>",
     "committer": {
      "date": "2026-11-24T21:35:52Z"
     }
    }
   },
   {
    "sha": "680b9cb0918e44c1595226fe50b1e0c1714d4829",
    "parents": [
     {
      "sha": "7c69f27dd8aac57d63d8c24cb98e068a496bfdbb"
     }
    ],
    "commit": {
     "message": "Warn for embeddings only when vectors run\n\nSigned-off-by: ValeraZSD <valerazsd@gmail.com>",
     "committer": {
      "date": "2026-11-24T21:37:33Z"
     }
    }
   }
